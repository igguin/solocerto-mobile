# Copie este arquivo para ".env" e ajuste.
# true  = usa dados simulados (mock), não precisa de servidor.
# false = usa a API real (Java/Spring Boot) no endereço abaixo.
EXPO_PUBLIC_USE_MOCK=true

# Endereço da API real. No celular, use o IP do computador na rede (não "localhost").
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
